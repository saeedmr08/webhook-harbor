# WebhookHarbor demo — placeholders only. Do not commit real secrets.
# Shared HMAC secret used when creating demo endpoints (optional override).
WEBHOOK_HARBOR_DEFAULT_SECRET=replace-with-a-long-random-secret

# Replay protection window in milliseconds (default: 300000 = 5 minutes).
WEBHOOK_HARBOR_REPLAY_WINDOW_MS=300000

# Max retry attempts simulated for failed deliveries.
WEBHOOK_HARBOR_MAX_RETRIES=5
